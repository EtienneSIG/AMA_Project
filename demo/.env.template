# --- Azure subscription / tenant ---
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=westeurope
AZURE_ENV_NAME=learneu-demo

# --- External ID / B2C tenant ---
B2C_TENANT_ID=00000000-0000-0000-0000-000000000000
B2C_TENANT_DOMAIN=learneu.onmicrosoft.com

# --- Azure OpenAI ---
OPENAI_DEPLOYMENT_NAME=gpt-5.4-nano
OPENAI_PTU=50

# --- GitHub (optional) ---
GITHUB_OWNER=
GITHUB_REPO=

# --- Demo synthetic data ---
SYNTHETIC_LEARNERS_COUNT=50
DEMO_SUBJECT=math
DEMO_GRADE=7

# --- PostgreSQL (set automatically by Bicep app-service.bicep on Azure) ---
# Local dev: leave PG_HOST empty to use the in-memory fallback.
PG_HOST=
PG_PORT=5432
PG_DATABASE=learneu
PG_USER=learneu_admin
PG_PASSWORD=
PG_SSL=require

# --- Notes ---
# 1. Copy this file to `.env.local` and fill in real values.
# 2. Never commit `.env.local` to source control.
# 3. The Demo Deployment Agent reads `.env.local` and never echoes its values back to chat.
