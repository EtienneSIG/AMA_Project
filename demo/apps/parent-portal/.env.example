# Parent Portal — environment template (006-parent-portal)
# Copy to `.env` for local runs. In Azure these are injected as App Settings /
# Key Vault references. NEVER commit real secrets. EU regions only for any
# personal data (constitution: EU residency).

# --- App identity ---
APP_ROLE=parent
APP_NAME=parent
PORT=8080
REGION_NAME=westeurope

# --- PostgreSQL (EU Flexible Server) ---
PG_HOST=pg-learneu-demo.postgres.database.azure.com
PG_PORT=5432
PG_DATABASE=learneu
PG_USER=
PG_PASSWORD=
PG_SSL=require

# --- Session / CSRF / rate limiting ---
SESSION_SECRET=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOGIN=10
RATE_LIMIT_API=60

# --- Azure AI Content Safety (message moderation, SC-005) ---
# Auth is AAD / Managed Identity (disableLocalAuth is enforced by policy).
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_ENABLED=true
CONTENT_SAFETY_THRESHOLD=4

# --- GDPR Art. 8 parental consent ---
# Consent link time-to-live in days (US3; reminder fires on day 6).
CONSENT_LINK_TTL_DAYS=7

# --- Weekly digest scheduling (US4) ---
# Dispatcher batches on Sunday 18:00 UTC. SMTP is optional in the demo
# (digests are persisted to the DB and surfaced in-portal when unset).
DIGEST_SEND_DOW=0
DIGEST_SEND_HOUR_UTC=18
DIGEST_SMTP_HOST=
DIGEST_SMTP_PORT=587
DIGEST_SMTP_USER=
DIGEST_SMTP_PASSWORD=
DIGEST_FROM_ADDRESS=no-reply@learneu.demo
