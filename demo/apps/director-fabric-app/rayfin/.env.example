# rayfin/.env.example — copy to rayfin/.env (excluded from VCS) and fill secrets.
# EU-resident Fabric workspace/capacity only.
RAYFIN_WORKSPACE=EULearn
RAYFIN_CAPACITY=cap-learneu-demo
RAYFIN_REGION=northeurope
# Shared HMAC secret used to verify the portal-signed ScopeContext (fail-closed).
SCOPE_CONTEXT_SECRET=replace-with-shared-secret
